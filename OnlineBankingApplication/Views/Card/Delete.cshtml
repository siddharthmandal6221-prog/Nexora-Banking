@model OnlineBankingApplication.DTOs.CardDto

@{
    ViewData["Title"] = "Delete Card";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none">
            ← Back to Cards
        </a>

        <h1 class="fw-bold mt-3 mb-1">
            Delete Card
        </h1>

        <p class="text-muted">
            Review the card before permanently deleting it.
        </p>

    </div>


    <div class="card delete-card">

        <div class="card-body p-4">

            <div class="warning-box mb-4">

                <div class="warning-icon">
                    ⚠
                </div>

                <div>
                    <h5>
                        Are you sure you want to delete this card?
                    </h5>

                    <p>
                        This action cannot be undone.
                    </p>
                </div>

            </div>


            <div class="bank-card mb-4">

                <div class="card-top">

                    <span class="network">
                        @Model.CardNetwork
                    </span>

                    <span>
                        @Model.CardType
                    </span>

                </div>


                <div class="card-chip">
                    ▣
                </div>


                <div class="card-number">
                    •••• •••• •••• @Model.LastFourDigits
                </div>


                <div class="card-bottom">

                    <div>

                        <small>Card Holder</small>

                        <strong>
                            @Model.CardHolderName
                        </strong>

                    </div>


                    <div>

                        <small>Expires</small>

                        <strong>
                            @Model.ExpiryMonth.ToString("00")/@Model.ExpiryYear
                        </strong>

                    </div>

                </div>

            </div>


            <div class="details-list">

                <div class="detail-row">

                    <span>Card ID</span>

                    <strong>
                        @Model.CardId
                    </strong>

                </div>


                <div class="detail-row">

                    <span>Card Type</span>

                    <strong>
                        @Model.CardType
                    </strong>

                </div>


                <div class="detail-row">

                    <span>Card Network</span>

                    <strong>
                        @Model.CardNetwork
                    </strong>

                </div>


                <div class="detail-row">

                    <span>Bank Account</span>

                    <strong>
                        @Model.BankAccountNumber
                    </strong>

                </div>


                <div class="detail-row">

                    <span>Status</span>

                    @if (Model.IsActive)
                    {
                        <strong class="text-success">
                            Active
                        </strong>
                    }
                    else
                    {
                        <strong class="text-secondary">
                            Inactive
                        </strong>
                    }

                </div>

            </div>


            <hr class="my-4" />


            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.CardId" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Card
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .delete-card {
        background: white;
        border: 1px solid #e9e2ff;
        border-radius: 18px;
        max-width: 850px;
        box-shadow: 0 8px 25px rgba(90,60,150,.06);
    }

    .warning-box {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #fff8e8;
        border: 1px solid #f4dfad;
        border-radius: 12px;
        padding: 16px;
    }

    .warning-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #ffe9ad;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .warning-box h5 {
        margin: 0 0 4px;
        font-weight: 700;
        color: #6c5200;
    }

    .warning-box p {
        margin: 0;
        color: #856d2b;
        font-size: 13px;
    }

    .bank-card {
        background: linear-gradient(135deg, #5f35d9, #9a6cf2);
        color: white;
        border-radius: 18px;
        padding: 25px;
        max-width: 500px;
        min-height: 220px;
        box-shadow: 0 12px 25px rgba(112,71,232,.2);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .network {
        font-size: 18px;
        font-weight: 700;
    }

    .card-chip {
        margin-top: 28px;
        font-size: 27px;
    }

    .card-number {
        margin-top: 15px;
        font-size: 20px;
        letter-spacing: 2px;
        font-weight: 600;
    }

    .card-bottom {
        display: flex;
        justify-content: space-between;
        margin-top: 25px;
    }

        .card-bottom small {
            display: block;
            font-size: 9px;
            opacity: .7;
            text-transform: uppercase;
        }

        .card-bottom strong {
            display: block;
            margin-top: 4px;
            font-size: 13px;
        }

    .details-list {
        max-width: 700px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #eeeaf7;
    }

        .detail-row span {
            color: #77738a;
            font-size: 14px;
        }

        .detail-row strong {
            color: #29263c;
            font-size: 14px;
        }

</style>