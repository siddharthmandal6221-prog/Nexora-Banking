@model OnlineBankingApplication.DTOs.TransactionDto

@{
    ViewData["Title"] = "Transaction Details";

    var isSuccess = Model.Status == "Success";
}

<div class="container-fluid px-0">

    <!-- Header -->
    <div class="mb-4">

        <a asp-action="Index"
           class="back-link">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Transactions

        </a>

        <div class="d-flex justify-content-between align-items-center mt-3">

            <div>

                <h1 class="fw-bold mb-1">
                    Transaction Details
                </h1>

                <p class="text-muted mb-0">
                    View complete details of your transaction.
                </p>

            </div>

            @if (isSuccess)
            {
                <span class="success-badge">
                    <i class="bi bi-check-circle me-1"></i>
                    Successful
                </span>
            }
            else
            {
                <span class="status-badge">
                    @Model.Status
                </span>
            }

        </div>

    </div>


    <!-- Main Receipt -->
    <div class="receipt-card">

        <!-- Receipt Header -->
        <div class="receipt-header">

            <div>

                <span class="receipt-label">
                    TRANSACTION ID
                </span>

                <h2 class="transaction-number">
                    #@Model.TransactionId
                </h2>

            </div>

            <div class="receipt-icon">
                <i class="bi bi-receipt"></i>
            </div>

        </div>


        <!-- Amount -->
        <div class="amount-section">

            <span class="amount-label">
                TRANSACTION AMOUNT
            </span>

            <div class="amount">
                ₹@Model.Amount.ToString("N2")
            </div>

            <span class="amount-type">
                @Model.TransactionType
            </span>

        </div>


        <!-- Account Transfer -->
        <div class="transfer-section">

            <div class="account-box">

                <div class="account-icon">
                    <i class="bi bi-arrow-up-right"></i>
                </div>

                <div>

                    <span class="field-label">
                        FROM ACCOUNT
                    </span>

                    <div class="account-number">
                        Account ID: @Model.FromBankAccountId
                    </div>

                </div>

            </div>


            <div class="transfer-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>


            <div class="account-box">

                <div class="account-icon">
                    <i class="bi bi-arrow-down-left"></i>
                </div>

                <div>

                    <span class="field-label">
                        TO ACCOUNT
                    </span>

                    <div class="account-number">
                        @Model.ToAccountNumber
                    </div>

                </div>

            </div>

        </div>


        <!-- Details -->
        <div class="details-section">

            <div class="detail-row">

                <span class="detail-label">
                    Transaction Type
                </span>

                <span class="detail-value">

                    <span class="type-badge">
                        @Model.TransactionType
                    </span>

                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    From Bank Account ID
                </span>

                <span class="detail-value">
                    @Model.FromBankAccountId
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Destination Account
                </span>

                <span class="detail-value">
                    @Model.ToAccountNumber
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Transaction Date
                </span>

                <span class="detail-value">
                    @Model.TransactionDate.ToString("dd MMM yyyy")
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Transaction Time
                </span>

                <span class="detail-value">
                    @Model.TransactionDate.ToString("hh:mm:ss tt")
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Status
                </span>

                <span class="detail-value">

                    @if (isSuccess)
                    {
                        <span class="success-badge">
                            <i class="bi bi-check-circle me-1"></i>
                            Success
                        </span>
                    }
                    else
                    {
                        <span class="status-badge">
                            @Model.Status
                        </span>
                    }

                </span>

            </div>

        </div>


        <!-- Footer -->
        <div class="receipt-footer">

            <div class="secure-info">

                <i class="bi bi-shield-check"></i>

                <div>

                    <strong>
                        Secure Transaction
                    </strong>

                    <small>
                        This transaction has been securely recorded.
                    </small>

                </div>

            </div>


            <a asp-action="Index"
               class="btn btn-primary px-4">

                Back to Transactions

            </a>

        </div>

    </div>

</div>


<style>

    .back-link {
        color: #7047e8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .back-link:hover {
            color: #5833c7;
        }

    .receipt-card {
        background: #ffffff;
        border: 1px solid #e9e2ff;
        border-radius: 22px;
        max-width: 1000px;
        margin: 0 auto;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(90, 60, 150, 0.08);
    }

    .receipt-header {
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eeeaf7;
    }

    .receipt-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #89859c;
    }

    .transaction-number {
        margin: 6px 0 0;
        color: #17213d;
        font-size: 26px;
    }

    .receipt-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: #f0e9ff;
        color: #7047e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .amount-section {
        text-align: center;
        padding: 38px 20px;
        background: #faf9ff;
        border-bottom: 1px solid #eeeaf7;
    }

    .amount-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #89859c;
    }

    .amount {
        font-size: 42px;
        font-weight: 750;
        color: #17213d;
        margin: 8px 0;
    }

    .amount-type {
        display: inline-block;
        background: #eee7ff;
        color: #7047e8;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .transfer-section {
        padding: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 35px;
        border-bottom: 1px solid #eeeaf7;
    }

    .account-box {
        flex: 1;
        max-width: 360px;
        border: 1px solid #e7e0f7;
        border-radius: 15px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        background: #ffffff;
    }

    .account-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #f0e9ff;
        color: #7047e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .field-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #918da4;
        letter-spacing: 0.7px;
        margin-bottom: 5px;
    }

    .account-number {
        font-size: 18px;
        font-weight: 700;
        color: #17213d;
    }

    .transfer-arrow {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #7047e8;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .details-section {
        padding: 10px 35px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 19px 0;
        border-bottom: 1px solid #f0edf7;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #77738a;
        font-size: 14px;
    }

    .detail-value {
        color: #25223a;
        font-size: 14px;
        font-weight: 600;
    }

    .type-badge {
        background: #eee7ff;
        color: #7047e8;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
    }

    .success-badge {
        background: #e8f8ef;
        color: #16834b;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge {
        background: #fff1dd;
        color: #a66a00;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
    }

    .receipt-footer {
        padding: 25px 35px;
        background: #faf9ff;
        border-top: 1px solid #eeeaf7;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .secure-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .secure-info > i {
            font-size: 25px;
            color: #7047e8;
        }

        .secure-info strong {
            display: block;
            font-size: 13px;
            color: #29263c;
        }

        .secure-info small {
            display: block;
            color: #8a869c;
            font-size: 11px;
            margin-top: 3px;
        }

    @@media (max-width: 768px) {

        .transfer-section {
            flex-direction: column;
            gap: 15px;
        }

        .account-box {
            width: 100%;
            max-width: none;
        }

        .transfer-arrow {
            transform: rotate(90deg);
        }

        .receipt-header,
        .receipt-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .amount {
            font-size: 34px;
        }
    }

</style>