@model IEnumerable<OnlineBankingApplication.DTOs.CustomerDto>

@{
    ViewData["Title"] = "Customer Management";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1>
            <i class="bi bi-people-fill me-2 text-cyan"></i>
            @(isAdmin ? "Customer Management" : "My Customer Profile")
        </h1>
        <p>
            @(isAdmin
                ? "Manage and review registered banking customers in Nexora Portal."
                : "View your registered customer profile information.")
        </p>
    </div>

    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-yono-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Add Customer
        </a>
    }
</div>

<!-- SUMMARY CARDS -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="dashboard-card">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-secondary small fw-medium text-uppercase d-block">
                        @(isAdmin ? "Registered Customers" : "Your Profile")
                    </span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                    <i class="bi bi-person-badge-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-secondary small fw-medium text-uppercase d-block">Customer Records</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Count()</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shield-check-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-secondary small fw-medium text-uppercase d-block">Management Status</span>
                    <h3 class="fw-bold mb-0 text-success">Active</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CUSTOMER TABLE -->
<div class="dashboard-card p-0 overflow-hidden">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-table me-2 text-primary"></i>Customer Records
        </h5>
        <span class="badge bg-primary px-3 py-2 rounded-pill">
            @Model.Count() @(Model.Count() == 1 ? "Customer" : "Customers")
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="stat-icon-wrapper mx-auto mb-3 bg-light text-secondary" style="width:60px; height:60px;">
                <i class="bi bi-people fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">No customer records found</h5>
            <p class="text-muted small">
                @(isAdmin
                    ? "There are currently no customers registered in the banking system."
                    : "Your customer profile has not been created yet.")
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Created</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-navy text-white fw-bold d-flex align-items-center justify-content-center" style="width:40px; height:40px; font-size: 14px;">
                                        @(string.IsNullOrWhiteSpace(customer.FullName)
                                            ? "C"
                                            : customer.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <span class="fw-semibold text-dark d-block">@customer.FullName</span>
                                        <small class="text-muted">ID: #@customer.CustomerId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-dark">@customer.Email</span>
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(customer.PhoneNumber) ? "-" : customer.PhoneNumber)
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(customer.Address) ? "-" : customer.Address)
                            </td>
                            <td>
                                <span class="text-secondary small">@customer.CreatedDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn btn-outline-primary">
                                        <i class="bi bi-eye-fill me-1"></i>Details
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-outline-secondary">
                                            <i class="bi bi-pencil-fill me-1"></i>Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@customer.CustomerId" class="btn btn-outline-danger">
                                            <i class="bi bi-trash-fill me-1"></i>Delete
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>