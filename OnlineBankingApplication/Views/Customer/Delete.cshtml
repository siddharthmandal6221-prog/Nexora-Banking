@model OnlineBankingApplication.DTOs.CustomerDto
@{
    ViewData["Title"] = "Delete Customer";
}

<style>
    .delete-page {
        max-width: 750px;
        margin: 0 auto;
        padding: 35px 24px 50px;
    }

    .delete-card {
        background: white;
        border: 1px solid #eeeaf8;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 8px 28px rgba(38,23,74,.07);
    }

    .warning-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 17px;
        border-radius: 17px;
        background: #fff0f1;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .delete-title {
        color: #21183b;
        text-align: center;
        font-size: 23px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .delete-description {
        color: #837b91;
        text-align: center;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .customer-summary {
        background: #faf9fd;
        border: 1px solid #eeeaf8;
        border-radius: 13px;
        padding: 18px;
        margin-bottom: 24px;
    }

    .summary-row-custom {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 9px 0;
        border-bottom: 1px solid #eeeaf8;
    }

        .summary-row-custom:last-child {
            border-bottom: none;
        }

    .summary-label {
        color: #8b8499;
        font-size: 12px;
    }

    .summary-value {
        color: #302746;
        font-size: 12px;
        font-weight: 600;
        text-align: right;
    }

    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .delete-btn {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 10px 18px;
        font-size: 12px;
        font-weight: 600;
    }

    .cancel-btn {
        background: #f2eff7;
        color: #514965;
        border-radius: 9px;
        padding: 10px 18px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }
</style>

<div class="delete-page">

    <div class="delete-card">

        <div class="warning-icon">!</div>

        <div class="delete-title">
            Delete Customer
        </div>

        <div class="delete-description">
            Are you sure you want to delete this customer record?
            This action cannot be undone.
        </div>

        <div class="customer-summary">

            <div class="summary-row-custom">
                <span class="summary-label">Customer ID</span>
                <span class="summary-value">#@Model.CustomerId</span>
            </div>

            <div class="summary-row-custom">
                <span class="summary-label">Full Name</span>
                <span class="summary-value">@Model.FullName</span>
            </div>

            <div class="summary-row-custom">
                <span class="summary-label">Email</span>
                <span class="summary-value">@Model.Email</span>
            </div>

            <div class="summary-row-custom">
                <span class="summary-label">Phone</span>
                <span class="summary-value">
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                        ? "-"
                        : Model.PhoneNumber)
                </span>
            </div>

        </div>

        <form asp-action="Delete"
              asp-route-id="@Model.CustomerId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="confirm"
                   value="true" />

            <div class="delete-actions">

                <button type="submit" class="delete-btn">
                    Delete Customer
                </button>

                <a asp-action="Index" class="cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>