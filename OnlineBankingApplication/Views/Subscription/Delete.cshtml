@model OnlineBankingApplication.DTOs.SubscriptionDto

@{
    ViewData["Title"] = "Delete Subscription";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <h1 class="fw-bold">
            Delete Subscription
        </h1>

        <p class="text-muted">
            Confirm that you want to delete this subscription.
        </p>

    </div>


    <div class="delete-card">

        <div class="warning-icon">
            !
        </div>

        <h3>
            Delete @Model.MerchantName?
        </h3>

        <p>
            This action cannot be undone.
        </p>


        <div class="subscription-summary">

            <div>

                <span>
                    Merchant
                </span>

                <strong>
                    @Model.MerchantName
                </strong>

            </div>


            <div>

                <span>
                    Amount
                </span>

                <strong>
                    ₹@Model.Amount.ToString("N2")
                </strong>

            </div>


            <div>

                <span>
                    Billing Cycle
                </span>

                <strong>
                    @Model.BillingCycle
                </strong>

            </div>


            <div>

                <span>
                    Customer
                </span>

                <strong>
                    @Model.CustomerName
                </strong>

            </div>


            <div>

                <span>
                    Bank Account
                </span>

                <strong>
                    @Model.BankAccountNumber
                </strong>

            </div>


            <div>

                <span>
                    Status
                </span>

                <strong>
                    @Model.Status
                </strong>

            </div>

        </div>


        <form asp-action="Delete"
              method="post"
              class="mt-4">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="SubscriptionId" />

            <button type="submit"
                    class="btn btn-danger">

                Delete Subscription

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>


<style>

    .delete-card {
        background: white;
        border: 1px solid #e9e2ff;
        border-radius: 18px;
        padding: 35px;
        max-width: 750px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(90,60,150,.06);
    }

    .warning-icon {
        width: 60px;
        height: 60px;
        margin: auto;
        border-radius: 50%;
        background: #fdeaea;
        color: #d9534f;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 700;
    }

    .delete-card h3 {
        margin-top: 18px;
    }

    .delete-card p {
        color: #77738a;
    }

    .subscription-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 25px;
        text-align: left;
    }

        .subscription-summary div {
            background: #faf9ff;
            padding: 15px;
            border-radius: 10px;
        }

        .subscription-summary span {
            display: block;
            font-size: 11px;
            color: #77738a;
        }

        .subscription-summary strong {
            display: block;
            margin-top: 5px;
            color: #17213d;
        }

    @@media (max-width: 768px) {

        .subscription-summary {
            grid-template-columns: 1fr;
        }
    }

</style>