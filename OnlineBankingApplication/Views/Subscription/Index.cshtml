@model IEnumerable<OnlineBankingApplication.DTOs.SubscriptionDto>

@{
    ViewData["Title"] = "Subscriptions";

    var subscriptions = Model?.ToList()
        ?? new List<OnlineBankingApplication.DTOs.SubscriptionDto>();

    var activeSubscriptions = subscriptions
        .Where(s => s.Status == "Active")
        .ToList();

    var totalAmount = activeSubscriptions.Sum(s => s.Amount);
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: var(--nexora-text-heading); font-size: 30px;">
                Subscriptions
            </h1>
            <p class="text-muted m-0" style="font-size: 14px;">
                Manage your recurring bill payments and subscriptions.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Subscription"
               asp-action="Create"
               class="btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Add Subscription
            </a>
        }
    </div>

    <!-- Summary Tiles -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px;">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Total Subscriptions</span>
                    <h2 class="fw-bold fs-3 text-dark m-0">@subscriptions.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px; background: #dcfce7; color: #15803d;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Active Subscriptions</span>
                    <h2 class="fw-bold fs-3 text-success m-0">@activeSubscriptions.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Monthly Total Amount</span>
                    <h2 class="fw-bold fs-3 text-primary m-0">₹@totalAmount.ToString("N2")</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Subscriptions Table Card -->
    <div class="section-card">

        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">

            <div>
                <h5 class="fw-bold text-dark fs-6 mb-1">My Subscriptions</h5>
                <p class="text-muted m-0" style="font-size: 13px;">Your registered recurring payment services.</p>
            </div>

            <span class="badge bg-primary text-white fw-bold px-3 py-2" style="border-radius: 20px;">
                @subscriptions.Count @(subscriptions.Count == 1 ? "Subscription" : "Subscriptions")
            </span>

        </div>

        @if (subscriptions.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Merchant</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Billing Cycle</th>
                            <th>Next Payment</th>
                            <th>Status</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var subscription in subscriptions)
                        {
                            var initial = string.IsNullOrWhiteSpace(subscription.MerchantName)
                                ? "?"
                                : subscription.MerchantName.Substring(0, 1).ToUpper();

                            var statusClass = subscription.Status?.ToLowerInvariant() == "active"
                                ? "badge-active"
                                : "badge-rejected";

                            <tr>

                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="user-avatar" style="width: 40px; height: 40px; font-size: 15px; background: #e0f2fe; color: #0284c7;">
                                            @initial
                                        </div>

                                        <div>
                                            <strong class="d-block text-dark" style="font-size: 14px;">
                                                @subscription.MerchantName
                                            </strong>

                                            <small class="text-muted" style="font-size: 11px;">
                                                @subscription.BillingCycle
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        @(subscription.Category ?? "General")
                                    </span>
                                </td>

                                <td class="fw-bold fs-6">
                                    ₹@subscription.Amount.ToString("N2")
                                </td>

                                <td class="fw-semibold text-muted">
                                    @subscription.BillingCycle
                                </td>

                                <td class="fw-semibold text-dark">
                                    @subscription.NextPaymentDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="badge-status @statusClass">
                                        @subscription.Status
                                    </span>
                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a asp-controller="Subscription"
                                           asp-action="Details"
                                           asp-route-id="@subscription.SubscriptionId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Subscription"
                                               asp-action="Edit"
                                               asp-route-id="@subscription.SubscriptionId"
                                               class="btn btn-sm btn-secondary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <a asp-controller="Subscription"
                                               asp-action="Delete"
                                               asp-route-id="@subscription.SubscriptionId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div class="stat-icon-badge mx-auto mb-3" style="width: 56px; height: 56px; font-size: 24px;">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h5 class="fw-bold text-dark mb-1">No Active Subscriptions</h5>

                <p class="text-muted mb-3" style="font-size: 13px;">
                    Your recurring payment services will appear here.
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Subscription"
                       asp-action="Create"
                       class="btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Add Subscription
                    </a>
                }

            </div>
        }

    </div>

</div>