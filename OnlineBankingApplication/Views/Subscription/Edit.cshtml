@model OnlineBankingApplication.DTOs.SubscriptionDto

@{
    ViewData["Title"] = "Edit Subscription";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Edit Subscription
        </h1>

        <p class="text-muted">
            Update subscription information.
        </p>

    </div>


    <div class="card form-card">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="SubscriptionId" />

                <input type="hidden"
                       asp-for="CustomerId" />

                <input type="hidden"
                       asp-for="BankAccountId" />

                <input type="hidden"
                       asp-for="CreatedDate" />


                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="MerchantName"
                               class="form-label">

                            Merchant Name

                        </label>

                        <input asp-for="MerchantName"
                               class="form-control" />

                        <span asp-validation-for="MerchantName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Category"
                               class="form-label">

                            Category

                        </label>

                        <select asp-for="Category"
                                class="form-select">

                            <option value="">
                                -- Select Category --
                            </option>

                            <option value="Entertainment">
                                Entertainment
                            </option>

                            <option value="Utilities">
                                Utilities
                            </option>

                            <option value="Insurance">
                                Insurance
                            </option>

                            <option value="Shopping">
                                Shopping
                            </option>

                            <option value="Education">
                                Education
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <span asp-validation-for="Category"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Amount"
                               class="form-label">

                            Amount

                        </label>

                        <input asp-for="Amount"
                               class="form-control"
                               type="number"
                               step="0.01" />

                        <span asp-validation-for="Amount"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="BillingCycle"
                               class="form-label">

                            Billing Cycle

                        </label>

                        <select asp-for="BillingCycle"
                                class="form-select">

                            <option value="Weekly">
                                Weekly
                            </option>

                            <option value="Monthly">
                                Monthly
                            </option>

                            <option value="Quarterly">
                                Quarterly
                            </option>

                            <option value="Yearly">
                                Yearly
                            </option>

                        </select>

                        <span asp-validation-for="BillingCycle"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="NextPaymentDate"
                               class="form-label">

                            Next Payment Date

                        </label>

                        <input asp-for="NextPaymentDate"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="NextPaymentDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Status"
                               class="form-label">

                            Status

                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Customer
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.CustomerName"
                               readonly />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Bank Account
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.BankAccountNumber"
                               readonly />

                    </div>

                </div>


                <hr class="my-4" />


                <button type="submit"
                        class="btn btn-primary">

                    Save Changes

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>


<style>

    .form-card {
        max-width: 900px;
        background: white;
        border: 1px solid #e9e2ff;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(90,60,150,.06);
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #55536b;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        min-height: 42px;
        border: 1px solid #ddd8ef;
    }

</style>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}