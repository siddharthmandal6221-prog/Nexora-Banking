@model OnlineBankingApplication.DTOs.BeneficiaryDto

@{
    ViewData["Title"] = "Delete Beneficiary";
}

<h1>Delete Beneficiary</h1>

<h3>
    Are you sure you want to delete this beneficiary?
</h3>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Beneficiary ID
            </dt>

            <dd class="col-sm-9">
                @Model.BeneficiaryId
            </dd>

            <dt class="col-sm-3">
                Beneficiary Name
            </dt>

            <dd class="col-sm-9">
                @Model.BeneficiaryName
            </dd>

            <dt class="col-sm-3">
                Account Number
            </dt>

            <dd class="col-sm-9">
                @Model.AccountNumber
            </dd>

            <dt class="col-sm-3">
                Bank Name
            </dt>

            <dd class="col-sm-9">
                @Model.BankName
            </dd>

            <dt class="col-sm-3">
                Customer ID
            </dt>

            <dd class="col-sm-9">
                @Model.CustomerId
            </dd>

        </dl>

        <form asp-action="Delete"
              asp-route-id="@Model.BeneficiaryId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="confirm"
                   value="true" />

            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>