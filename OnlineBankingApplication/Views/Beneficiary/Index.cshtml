@model IEnumerable<OnlineBankingApplication.DTOs.BeneficiaryDto>

@{
    ViewData["Title"] = "Beneficiaries";

    var isAdmin = User.IsInRole("Admin");

    var beneficiaries =
        Model?.ToList()
        ?? new List<OnlineBankingApplication.DTOs.BeneficiaryDto>();

    var bankCount = beneficiaries
        .Select(b => b.BankName)
        .Where(b => !string.IsNullOrWhiteSpace(b))
        .Distinct()
        .Count();
}

<div class="beneficiary-page">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1" style="color: var(--nexora-text-heading); font-size: 32px;">
                Beneficiaries
            </h1>

            <p class="text-muted m-0" style="font-size: 14px;">
                @(isAdmin
                    ? "Manage registered beneficiaries across customer accounts."
                    : "Manage the people and accounts you frequently transfer money to.")
            </p>
        </div>

        <a asp-action="Create"
           class="add-beneficiary-btn">
            <i class="bi bi-person-plus-fill me-1"></i> Add Beneficiary
        </a>

    </div>

    <!-- Summary Row -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted fw-semibold mb-1" style="font-size: 13px;">
                        Total Beneficiaries
                    </div>

                    <div class="fw-bold fs-3 text-dark">
                        @beneficiaries.Count
                    </div>
                </div>

                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 22px;">
                    <i class="bi bi-person-hearts"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted fw-semibold mb-1" style="font-size: 13px;">
                        Registered Banks
                    </div>

                    <div class="fw-bold fs-3 text-dark">
                        @bankCount
                    </div>
                </div>

                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 22px; background: #e0e7ff; color: #4338ca;">
                    <i class="bi bi-building"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted fw-semibold mb-1" style="font-size: 13px;">
                        @(isAdmin ? "Customer Records" : "Verified Records")
                    </div>

                    <div class="fw-bold fs-3 text-dark">
                        @beneficiaries.Count
                    </div>
                </div>

                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 22px; background: #f0fdf4; color: #16a34a;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>

    </div>


    <div class="section-card">

        <div class="p-4 border-bottom">

            <h2 class="fw-bold fs-5 mb-1" style="color: var(--nexora-text-heading);">
                @(isAdmin ? "All Beneficiaries" : "My Saved Beneficiaries")
            </h2>

            <p class="text-muted m-0" style="font-size: 13px;">
                @(isAdmin
                    ? "View and manage all beneficiary records."
                    : "Your verified beneficiary accounts for rapid money transfer.")
            </p>

        </div>

        @if (beneficiaries.Any())
        {
            <div class="p-4">

                <div class="row g-3">

                    @foreach (var beneficiary in beneficiaries)
                    {
                        var initial =
                            string.IsNullOrWhiteSpace(beneficiary.BeneficiaryName)
                                ? "?"
                                : beneficiary.BeneficiaryName
                                    .Substring(0, 1)
                                    .ToUpper();

                        <div class="col-lg-6">

                            <div class="beneficiary-card p-4 h-100">

                                <div class="d-flex align-items-center gap-3 mb-3">

                                    <div class="user-avatar" style="width: 48px; height: 48px; font-size: 18px; background: linear-gradient(135deg, #0052cc, #0284c7); color: white;">
                                        @initial
                                    </div>

                                    <div>

                                        <div class="fw-bold fs-6 text-dark mb-1">
                                            @beneficiary.BeneficiaryName
                                        </div>

                                        <div class="text-muted" style="font-size: 12px;">
                                            <i class="bi bi-hash"></i> Beneficiary ID: @beneficiary.BeneficiaryId
                                        </div>

                                    </div>

                                </div>

                                <div class="row g-2 mb-3">

                                    <div class="col-6">
                                        <div class="p-2 rounded-2" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                            <div class="text-uppercase text-muted fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">
                                                Account Number
                                            </div>

                                            <div class="fw-bold text-dark" style="font-size: 13px;">
                                                @beneficiary.AccountNumber
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <div class="p-2 rounded-2" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                            <div class="text-uppercase text-muted fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">
                                                Bank Name
                                            </div>

                                            <div class="fw-bold text-dark" style="font-size: 13px;">
                                                @beneficiary.BankName
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">

                                    @if (isAdmin)
                                    {
                                        <div class="text-muted" style="font-size: 12px;">
                                            Customer ID: <strong class="text-dark">@beneficiary.CustomerId</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted" style="font-size: 12px;">
                                            <i class="bi bi-shield-check text-success me-1"></i> Saved beneficiary
                                        </div>
                                    }

                                    <div class="d-flex gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@beneficiary.BeneficiaryId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@beneficiary.BeneficiaryId"
                                           class="btn btn-sm btn-secondary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@beneficiary.BeneficiaryId"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="text-center py-5 px-3">

                <div class="stat-icon-badge mx-auto mb-3" style="width: 64px; height: 64px; font-size: 28px; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-person-lines-fill"></i>
                </div>

                <h3 class="fw-bold fs-5 text-dark mb-2">
                    No Beneficiaries Found
                </h3>

                <p class="text-muted mb-4" style="font-size: 14px;">
                    Add a beneficiary to start transferring money seamlessly across accounts.
                </p>

                <div>

                    <a asp-action="Create"
                       class="add-beneficiary-btn">
                        <i class="bi bi-person-plus-fill me-1"></i> Add Beneficiary
                    </a>

                </div>

            </div>
        }

    </div>

</div>