@model OnlineBankingApplication.DTOs.ChequeBookRequestDto

@{
    ViewData["Title"] = "Request Cheque Book";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <a href="/ChequeBookRequest"
           class="back-link">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Requests
        </a>

        <h1 class="page-title mt-3">
            Request Cheque Book
        </h1>

        <p class="page-subtitle">
            Request a new cheque book for one of your bank accounts.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card form-card">

                <div class="card-body p-4 p-md-5">

                    <div class="form-header mb-4">

                        <div class="form-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>

                        <div>
                            <h4>Request Details</h4>

                            <p>
                                Select your account and the number of cheque leaves required.
                            </p>
                        </div>

                    </div>

                    <!-- IMPORTANT: Explicit POST URL -->
                    <form action="/ChequeBookRequest/Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="validation-summary">
                        </div>

                        <div class="mb-4">

                            <label asp-for="BankAccountId"
                                   class="form-label">
                                Bank Account
                            </label>

                            <select asp-for="BankAccountId"
                                    class="form-select">

                                <option value="">
                                    -- Select Bank Account --
                                </option>

                                @foreach (var account in ViewBag.BankAccounts)
                                {
                                    <option value="@account.BankAccountId">
                                        @account.AccountNumber

                                        @if (account.Customer != null)
                                        {
                                            <text>
                                                - @account.Customer.FullName
                                            </text>
                                        }

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="BankAccountId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="NumberOfLeaves"
                                   class="form-label">
                                Number of Leaves
                            </label>

                            <select asp-for="NumberOfLeaves"
                                    class="form-select">

                                <option value="">
                                    -- Select Number of Leaves --
                                </option>

                                <option value="25">
                                    25 Leaves
                                </option>

                                <option value="50">
                                    50 Leaves
                                </option>

                                <option value="100">
                                    100 Leaves
                                </option>

                            </select>

                            <span asp-validation-for="NumberOfLeaves"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="secure-message">

                            <i class="bi bi-shield-check"></i>

                            <div>

                                <strong>
                                    Secure Request
                                </strong>

                                <small>
                                    Your request will be submitted with Pending status for bank review.
                                </small>

                            </div>

                        </div>

                        <div class="form-actions">

                            <a href="/ChequeBookRequest"
                               class="cancel-button">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="primary-button">

                                <i class="bi bi-send me-2"></i>

                                Submit Request

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="info-card">

                <div class="info-header">

                    <div class="info-icon">
                        <i class="bi bi-journal-check"></i>
                    </div>

                    <h5>Cheque Book Options</h5>

                </div>

                <div class="leaf-option">

                    <div class="leaf-icon">
                        25
                    </div>

                    <div>
                        <strong>25 Leaves</strong>
                        <small>Standard cheque book</small>
                    </div>

                </div>

                <div class="leaf-option">

                    <div class="leaf-icon">
                        50
                    </div>

                    <div>
                        <strong>50 Leaves</strong>
                        <small>Medium cheque book</small>
                    </div>

                </div>

                <div class="leaf-option">

                    <div class="leaf-icon">
                        100
                    </div>

                    <div>
                        <strong>100 Leaves</strong>
                        <small>Large cheque book</small>
                    </div>

                </div>

                <div class="note-box">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        Requests are reviewed by the bank administrator before approval.
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .back-link {
        color: #7047e8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .page-title {
        font-size: 34px;
        font-weight: 750;
        color: #17213d;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #77738a;
        margin: 0;
    }

    .form-card,
    .info-card {
        background: #ffffff;
        border: 1px solid #e9e2ff;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(90, 60, 150, 0.06);
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eeeaf7;
    }

    .form-icon,
    .info-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #f0e9ff;
        color: #7047e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .form-header h4 {
        margin: 0 0 4px;
        color: #17213d;
        font-weight: 700;
    }

    .form-header p {
        margin: 0;
        color: #77738a;
        font-size: 13px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #4e4a61;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 46px;
        border-radius: 11px;
        border: 1px solid #ddd8ef;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #7047e8;
            box-shadow: 0 0 0 0.2rem rgba(112, 71, 232, 0.12);
        }

    .validation-summary {
        color: #c0392b;
        background: #fff4f4;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 20px;
    }

    .secure-message {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #faf9ff;
        border: 1px solid #ece5ff;
        border-radius: 12px;
        padding: 14px;
    }

        .secure-message > i {
            color: #7047e8;
            font-size: 22px;
        }

        .secure-message strong {
            display: block;
            color: #29263c;
            font-size: 13px;
        }

        .secure-message small {
            color: #77738a;
            font-size: 11px;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .cancel-button {
        border: 1px solid #ddd8ef;
        color: #625e73;
        background: white;
        text-decoration: none;
        border-radius: 10px;
        padding: 11px 20px;
        font-weight: 600;
    }

        .cancel-button:hover {
            color: #7047e8;
            border-color: #7047e8;
        }

    .primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #7047e8, #8c65ee);
        color: white;
        text-decoration: none;
        border: none;
        border-radius: 10px;
        padding: 11px 20px;
        font-weight: 650;
        box-shadow: 0 7px 18px rgba(112, 71, 232, 0.18);
        cursor: pointer;
    }

        .primary-button:hover {
            color: white;
            transform: translateY(-1px);
        }

    .info-card {
        padding: 25px;
    }

    .info-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

        .info-header h5 {
            margin: 0;
            color: #17213d;
            font-weight: 700;
        }

    .leaf-option {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px;
        background: #faf9ff;
        border-radius: 12px;
        margin-bottom: 10px;
    }

    .leaf-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #f0e9ff;
        color: #7047e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 11px;
    }

    .leaf-option strong {
        display: block;
        color: #29263c;
        font-size: 13px;
    }

    .leaf-option small {
        color: #8a869c;
        font-size: 11px;
    }

    .note-box {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        padding: 13px;
        background: #f0e9ff;
        color: #62548a;
        border-radius: 11px;
        font-size: 11px;
        line-height: 1.5;
    }

        .note-box i {
            color: #7047e8;
        }

    @@media (max-width: 768px) {

        .form-actions {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .primary-button {
            width: 100%;
            justify-content: center;
        }
    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}