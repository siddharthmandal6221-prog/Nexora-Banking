@model OnlineBankingApplication.DTOs.ChequeBookRequestDto

@{
    ViewData["Title"] = "Cheque Book Request Details";

    var isPending = Model.Status == "Pending";
    var isApproved = Model.Status == "Approved";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Requests
        </a>

        <div class="page-header mt-3">

            <div>

                <h1>
                    Request Details
                </h1>

                <p>
                    View complete information about your cheque book request.
                </p>

            </div>

            @if (isPending)
            {
                <span class="pending-badge">
                    <i class="bi bi-clock me-1"></i>
                    Pending
                </span>
            }
            else if (isApproved)
            {
                <span class="success-badge">
                    <i class="bi bi-check-circle me-1"></i>
                    Approved
                </span>
            }
            else
            {
                <span class="rejected-badge">
                    <i class="bi bi-x-circle me-1"></i>
                    @Model.Status
                </span>
            }

        </div>

    </div>

    <div class="details-card">

        <div class="details-header">

            <div>

                <span class="small-label">
                    REQUEST ID
                </span>

                <h2>
                    #@Model.ChequeBookRequestId
                </h2>

            </div>

            <div class="request-icon">
                <i class="bi bi-journal-text"></i>
            </div>

        </div>

        <div class="request-summary">

            <div class="summary-icon-large">
                <i class="bi bi-bank"></i>
            </div>

            <div>

                <span class="small-label">
                    BANK ACCOUNT
                </span>

                <h3>
                    @Model.BankAccountNumber
                </h3>

                <span class="account-type">
                    @Model.BankAccountType
                </span>

            </div>

        </div>

        <div class="details-section">

            <div class="detail-row">

                <span class="detail-label">
                    Request ID
                </span>

                <span class="detail-value">
                    #@Model.ChequeBookRequestId
                </span>

            </div>

            <div class="detail-row">

                <span class="detail-label">
                    Bank Account
                </span>

                <span class="detail-value">
                    @Model.BankAccountNumber
                </span>

            </div>

            <div class="detail-row">

                <span class="detail-label">
                    Number of Leaves
                </span>

                <span class="detail-value">
                    @Model.NumberOfLeaves Leaves
                </span>

            </div>

            <div class="detail-row">

                <span class="detail-label">
                    Request Date
                </span>

                <span class="detail-value">
                    @Model.RequestDate.ToString("dd MMM yyyy")
                </span>

            </div>

            <div class="detail-row">

                <span class="detail-label">
                    Request Time
                </span>

                <span class="detail-value">
                    @Model.RequestDate.ToString("hh:mm:ss tt")
                </span>

            </div>

            <div class="detail-row">

                <span class="detail-label">
                    Status
                </span>

                <span class="detail-value">

                    @if (isPending)
                    {
                        <span class="pending-badge">
                            Pending
                        </span>
                    }
                    else if (isApproved)
                    {
                        <span class="success-badge">
                            Approved
                        </span>
                    }
                    else
                    {
                        <span class="rejected-badge">
                            @Model.Status
                        </span>
                    }

                </span>

            </div>

        </div>

        <div class="details-footer">

            <div class="secure-info">

                <i class="bi bi-shield-check"></i>

                <div>

                    <strong>
                        Secure Banking Request
                    </strong>

                    <small>
                        Your cheque book request is securely recorded in the banking system.
                    </small>

                </div>

            </div>

            <div class="footer-actions">

                @if (isPending)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.ChequeBookRequestId"
                       class="edit-button">
                        Edit Request
                    </a>
                }

                <a asp-action="Index"
                   class="primary-button">
                    Back to Requests
                </a>

            </div>

        </div>

    </div>

</div>

<style>

    .back-link {
        color: #7047e8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .page-header h1 {
            font-size: 34px;
            font-weight: 750;
            color: #17213d;
            margin-bottom: 5px;
        }

        .page-header p {
            color: #77738a;
            margin: 0;
        }

    .details-card {
        background: #ffffff;
        border: 1px solid #e9e2ff;
        border-radius: 22px;
        max-width: 950px;
        margin: 0 auto;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(90, 60, 150, 0.08);
    }

    .details-header {
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eeeaf7;
    }

    .small-label {
        display: block;
        color: #918da4;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .details-header h2 {
        margin: 6px 0 0;
        color: #17213d;
        font-weight: 750;
    }

    .request-icon,
    .summary-icon-large {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: #f0e9ff;
        color: #7047e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .request-summary {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 30px 35px;
        background: #faf9ff;
        border-bottom: 1px solid #eeeaf7;
    }

        .request-summary h3 {
            margin: 5px 0;
            color: #17213d;
            font-weight: 750;
        }

    .account-type {
        color: #77738a;
        font-size: 12px;
    }

    .details-section {
        padding: 10px 35px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 19px 0;
        border-bottom: 1px solid #f0edf7;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #77738a;
        font-size: 14px;
    }

    .detail-value {
        color: #29263c;
        font-size: 14px;
        font-weight: 650;
    }

    .pending-badge,
    .success-badge,
    .rejected-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 11px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
    }

    .pending-badge {
        background: #fff4dc;
        color: #a56a00;
    }

    .success-badge {
        background: #e8f8ef;
        color: #16834b;
    }

    .rejected-badge {
        background: #fdeaea;
        color: #c0392b;
    }

    .details-footer {
        padding: 25px 35px;
        background: #faf9ff;
        border-top: 1px solid #eeeaf7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .secure-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .secure-info > i {
            font-size: 25px;
            color: #7047e8;
        }

        .secure-info strong {
            display: block;
            color: #29263c;
            font-size: 13px;
        }

        .secure-info small {
            display: block;
            color: #8a869c;
            font-size: 11px;
            margin-top: 3px;
        }

    .footer-actions {
        display: flex;
        gap: 10px;
    }

    .primary-button,
    .edit-button {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 650;
    }

    .primary-button {
        background: linear-gradient(135deg, #7047e8, #8c65ee);
        color: white;
    }

    .edit-button {
        background: #fff4dc;
        color: #996200;
    }

        .primary-button:hover,
        .edit-button:hover {
            color: inherit;
            transform: translateY(-1px);
        }

    .primary-button:hover {
        color: white;
    }

    @@media (max-width: 768px) {

        .page-header,
        .details-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer-actions {
            width: 100%;
            flex-direction: column;
        }

        .primary-button,
        .edit-button {
            justify-content: center;
            width: 100%;
        }
    }

</style>