@model OnlineBankingApplication.DTOs.ChequeBookRequestDto

@{
    ViewData["Title"] = "Delete Cheque Book Request";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <a asp-action="Index" class="back-link">

            <i class="bi bi-arrow-left me-2"></i>

            Back to Requests

        </a>

        <h1 class="page-title mt-3">
            Delete Cheque Book Request
        </h1>

        <p class="page-subtitle">
            Confirm whether you want to remove this pending request.
        </p>

    </div>

    <div class="delete-card">

        <div class="warning-section">

            <div class="warning-icon">

                <i class="bi bi-exclamation-triangle"></i>

            </div>

            <div>

                <h4>
                    Are you sure?
                </h4>

                <p>
                    This action will permanently delete the cheque book request.
                </p>

            </div>

        </div>

        <div class="request-details">

            <div class="detail-item">

                <span>
                    Request ID
                </span>

                <strong>
                    #@Model.ChequeBookRequestId
                </strong>

            </div>

            <div class="detail-item">

                <span>
                    Bank Account
                </span>

                <strong>
                    @Model.BankAccountNumber
                </strong>

            </div>

            <div class="detail-item">

                <span>
                    Number of Leaves
                </span>

                <strong>
                    @Model.NumberOfLeaves Leaves
                </strong>

            </div>

            <div class="detail-item">

                <span>
                    Request Date
                </span>

                <strong>
                    @Model.RequestDate.ToString("dd MMM yyyy, hh:mm tt")
                </strong>

            </div>

            <div class="detail-item">

                <span>
                    Current Status
                </span>

                <strong>

                    <span class="pending-badge">
                        @Model.Status
                    </span>

                </strong>

            </div>

        </div>

        <div class="delete-footer">

            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ChequeBookRequestId" />

                <input type="hidden"
                       name="confirm"
                       value="true" />

                <div class="delete-actions">

                    <a asp-action="Index"
                       class="cancel-button">

                        Cancel

                    </a>

                    <button type="submit"
                            class="delete-button">

                        <i class="bi bi-trash me-2"></i>

                        Delete Request

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>

    .back-link {
        color: #7047e8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .page-title {
        font-size: 34px;
        font-weight: 750;
        color: #17213d;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #77738a;
        margin: 0;
    }

    .delete-card {
        max-width: 850px;
        margin: 20px auto;
        background: #ffffff;
        border: 1px solid #e9e2ff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(90, 60, 150, 0.07);
    }

    .warning-section {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 30px 35px;
        background: #fffaf0;
        border-bottom: 1px solid #f2e4c3;
    }

    .warning-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: #fff0cf;
        color: #a56a00;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .warning-section h4 {
        color: #6f500f;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .warning-section p {
        color: #8b8068;
        margin: 0;
        font-size: 13px;
    }

    .request-details {
        padding: 10px 35px;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #f0edf7;
    }

        .detail-item:last-child {
            border-bottom: none;
        }

        .detail-item span:first-child {
            color: #77738a;
            font-size: 13px;
        }

        .detail-item strong {
            color: #29263c;
            font-size: 14px;
            text-align: right;
        }

    .pending-badge {
        display: inline-block;
        background: #fff4dc;
        color: #a56a00;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 11px;
    }

    .delete-footer {
        padding: 24px 35px;
        background: #faf9ff;
        border-top: 1px solid #eeeaf7;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .cancel-button,
    .delete-button {
        border-radius: 10px;
        padding: 11px 20px;
        font-weight: 650;
        text-decoration: none;
        font-size: 13px;
    }

    .cancel-button {
        color: #625e73;
        background: white;
        border: 1px solid #ddd8ef;
    }

    .delete-button {
        color: white;
        background: #d9534f;
        border: none;
    }

    .cancel-button:hover {
        color: #7047e8;
        background: #faf9ff;
    }

    .delete-button:hover {
        background: #c63f3b;
    }

    @@media (max-width: 768px) {

        .warning-section {
            align-items: flex-start;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .delete-button {
            width: 100%;
            text-align: center;
        }
    }

</style>