@model OnlineBankingApplication.DTOs.ChequeBookRequestDto

@{
    ViewData["Title"] = "Edit Cheque Book Request";
}

<div class="container-fluid px-0">

    <div class="mb-4">

        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Requests
        </a>

        <h1 class="page-title mt-3">
            Edit Cheque Book Request
        </h1>

        <p class="page-subtitle">
            Update the account or number of leaves for your pending request.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card form-card">

                <div class="card-body p-4 p-md-5">

                    <div class="form-header mb-4">

                        <div class="form-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <div>

                            <h4>Request Information</h4>

                            <p>
                                Make changes to your pending cheque book request.
                            </p>

                        </div>

                    </div>

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ChequeBookRequestId" />

                        <div asp-validation-summary="All"
                             class="validation-summary">
                        </div>

                        <div class="mb-4">

                            <label asp-for="BankAccountId"
                                   class="form-label">
                                Bank Account
                            </label>

                            <select asp-for="BankAccountId"
                                    class="form-select">

                                <option value="">
                                    -- Select Bank Account --
                                </option>

                                @foreach (var account in ViewBag.BankAccounts)
                                {
                                    <option value="@account.BankAccountId">
                                        @account.AccountNumber

                                        @if (account.Customer != null)
                                        {
                                            <text>
                                                - @account.Customer.FullName
                                            </text>
                                        }
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="BankAccountId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="NumberOfLeaves"
                                   class="form-label">
                                Number of Leaves
                            </label>

                            <select asp-for="NumberOfLeaves"
                                    class="form-select">

                                <option value="">
                                    -- Select Number of Leaves --
                                </option>

                                <option value="25">
                                    25 Leaves
                                </option>

                                <option value="50">
                                    50 Leaves
                                </option>

                                <option value="100">
                                    100 Leaves
                                </option>

                            </select>

                            <span asp-validation-for="NumberOfLeaves"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="status-display">

                            <div class="status-icon">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div>

                                <span>
                                    Current Status
                                </span>

                                <strong>
                                    @Model.Status
                                </strong>

                            </div>

                        </div>

                        <div class="form-actions">

                            <a asp-action="Index"
                               class="cancel-button">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="primary-button">

                                <i class="bi bi-check2 me-2"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="info-card">

                <div class="info-header">

                    <div class="info-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>

                    <h5>Request Status</h5>

                </div>

                <p class="info-text">
                    Only pending requests can be modified.
                    Once your request is approved or rejected, its status is managed by the bank.
                </p>

                <div class="status-flow">

                    <div class="flow-item active">

                        <span class="flow-dot"></span>

                        <div>
                            <strong>Pending</strong>
                            <small>Request submitted</small>
                        </div>

                    </div>

                    <div class="flow-line"></div>

                    <div class="flow-item">

                        <span class="flow-dot"></span>

                        <div>
                            <strong>Approved</strong>
                            <small>Bank accepts request</small>
                        </div>

                    </div>

                    <div class="flow-item">

                        <span class="flow-dot"></span>

                        <div>
                            <strong>Rejected</strong>
                            <small>Bank declines request</small>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .back-link {
        color: #7047e8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .page-title {
        font-size: 34px;
        font-weight: 750;
        color: #17213d;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #77738a;
        margin: 0;
    }

    .form-card,
    .info-card {
        background: #ffffff;
        border: 1px solid #e9e2ff;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(90, 60, 150, 0.06);
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eeeaf7;
    }

    .form-icon,
    .info-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: #f0e9ff;
        color: #7047e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .form-header h4 {
        margin: 0 0 4px;
        color: #17213d;
        font-weight: 700;
    }

    .form-header p {
        margin: 0;
        color: #77738a;
        font-size: 13px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #4e4a61;
        margin-bottom: 8px;
    }

    .form-select {
        min-height: 46px;
        border-radius: 11px;
        border: 1px solid #ddd8ef;
    }

        .form-select:focus {
            border-color: #7047e8;
            box-shadow: 0 0 0 0.2rem rgba(112, 71, 232, 0.12);
        }

    .validation-summary {
        color: #c0392b;
        background: #fff4f4;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 20px;
    }

    .status-display {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fffaf0;
        border: 1px solid #f4e2b9;
        border-radius: 12px;
        padding: 14px;
    }

    .status-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #fff0cf;
        color: #a56a00;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-display span {
        display: block;
        color: #8b8068;
        font-size: 11px;
    }

    .status-display strong {
        display: block;
        color: #8d5d00;
        font-size: 13px;
        margin-top: 3px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .cancel-button,
    .primary-button {
        border-radius: 10px;
        padding: 11px 20px;
        font-weight: 650;
        text-decoration: none;
        border: none;
    }

    .cancel-button {
        color: #625e73;
        background: white;
        border: 1px solid #ddd8ef;
    }

    .primary-button {
        display: inline-flex;
        align-items: center;
        color: white;
        background: linear-gradient(135deg, #7047e8, #8c65ee);
        box-shadow: 0 7px 18px rgba(112, 71, 232, 0.18);
    }

        .primary-button:hover {
            color: white;
            transform: translateY(-1px);
        }

    .info-card {
        padding: 25px;
    }

    .info-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

        .info-header h5 {
            margin: 0;
            color: #17213d;
            font-weight: 700;
        }

    .info-text {
        color: #77738a;
        font-size: 12px;
        line-height: 1.6;
    }

    .status-flow {
        margin-top: 22px;
    }

    .flow-item {
        display: flex;
        align-items: flex-start;
        gap: 11px;
    }

    .flow-dot {
        width: 11px;
        height: 11px;
        margin-top: 4px;
        border-radius: 50%;
        background: #ddd8ef;
        flex-shrink: 0;
    }

    .flow-item.active .flow-dot {
        background: #7047e8;
        box-shadow: 0 0 0 5px #f0e9ff;
    }

    .flow-item strong {
        display: block;
        color: #29263c;
        font-size: 12px;
    }

    .flow-item small {
        color: #8a869c;
        font-size: 10px;
    }

    .flow-line {
        width: 1px;
        height: 18px;
        background: #ddd8ef;
        margin: 2px 0 2px 5px;
    }

    @@media (max-width: 768px) {

        .form-actions {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .primary-button {
            width: 100%;
            text-align: center;
            justify-content: center;
        }
    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}