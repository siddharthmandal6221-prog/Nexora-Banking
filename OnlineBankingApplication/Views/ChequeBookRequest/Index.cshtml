@model IEnumerable<OnlineBankingApplication.DTOs.ChequeBookRequestDto>

@{
    ViewData["Title"] = "Cheque Book Requests";

    var requests = Model?.ToList()
        ?? new List<OnlineBankingApplication.DTOs.ChequeBookRequestDto>();

    var totalRequests = requests.Count;
    var pendingRequests = requests.Count(r => r.Status == "Pending");
    var approvedRequests = requests.Count(r => r.Status == "Approved");
    var rejectedRequests = requests.Count(r => r.Status == "Rejected");
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1" style="color: var(--nexora-text-heading); font-size: 30px;">
                Cheque Book Requests
            </h1>

            <p class="text-muted m-0" style="font-size: 14px;">
                Manage your cheque book requests and approval status.
            </p>
        </div>

        <a href="/ChequeBookRequest/Create"
           class="btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Request Cheque Book
        </a>

    </div>

    <!-- Summary Tiles -->
    <div class="row g-3 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px;">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Total Requests</span>
                    <h2 class="fw-bold fs-3 text-dark m-0">@totalRequests</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px; background: #fef3c7; color: #b45309;">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Pending</span>
                    <h2 class="fw-bold fs-3 text-warning m-0">@pendingRequests</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px; background: #dcfce7; color: #15803d;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Approved</span>
                    <h2 class="fw-bold fs-3 text-success m-0">@approvedRequests</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="summary-box p-4 d-flex align-items-center gap-3">
                <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 20px; background: #fee2e2; color: #b91c1c;">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 13px;">Rejected</span>
                    <h2 class="fw-bold fs-3 text-danger m-0">@rejectedRequests</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Info Banner -->
    <div class="alert alert-info border-0 d-flex align-items-center gap-3 mb-4 p-3" style="background: #e0f2fe; color: #0369a1; border-radius: 12px;">

        <div class="stat-icon-badge" style="width: 38px; height: 38px; font-size: 18px; background: #ffffff; color: #0284c7;">
            <i class="bi bi-info-circle-fill"></i>
        </div>

        <div>
            <strong class="d-block" style="font-size: 14px;">Cheque Book Service Notice</strong>
            <span style="font-size: 13px;">
                Submit requests for 25, 50, or 100 cheque leaves. Pending requests are verified by Nexora Bank administrators within 24 hours.
            </span>
        </div>

    </div>

    <!-- Requests Table Panel -->
    <div class="section-card">

        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">

            <div>
                <h5 class="fw-bold text-dark fs-6 mb-1">Your Requests</h5>
                <p class="text-muted m-0" style="font-size: 13px;">View and manage submitted cheque book requests.</p>
            </div>

            <span class="badge bg-primary text-white fw-bold px-3 py-2" style="border-radius: 20px;">
                @totalRequests request(s)
            </span>

        </div>

        @if (requests.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Request ID</th>
                            <th>Bank Account</th>
                            <th>Leaves</th>
                            <th>Request Date</th>
                            <th>Status</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var request in requests.OrderByDescending(r => r.RequestDate))
                        {
                            var statusClass = request.Status?.ToLowerInvariant() switch
                            {
                                "approved" => "badge-approved",
                                "pending" => "badge-pending",
                                _ => "badge-rejected"
                            };

                            <tr>

                                <td class="fw-bold text-primary">
                                    #@request.ChequeBookRequestId
                                </td>

                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="stat-icon-badge" style="width: 34px; height: 34px; font-size: 14px;">
                                            <i class="bi bi-bank2"></i>
                                        </div>

                                        <div>
                                            <strong class="d-block text-dark" style="font-size: 13px;">
                                                @request.BankAccountNumber
                                            </strong>

                                            <small class="text-muted" style="font-size: 11px;">
                                                @request.BankAccountType
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="bi bi-journal-text me-1 text-primary"></i>
                                        @request.NumberOfLeaves Leaves
                                    </span>
                                </td>

                                <td>

                                    <div class="fw-semibold text-dark">
                                        @request.RequestDate.ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted" style="font-size: 11px;">
                                        @request.RequestDate.ToString("hh:mm tt")
                                    </small>

                                </td>

                                <td>
                                    <span class="badge-status @statusClass">
                                        @request.Status
                                    </span>
                                </td>

                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        @if (request.Status == "Pending")
                                        {
                                            <a href="/ChequeBookRequest/Edit/@request.ChequeBookRequestId"
                                               class="btn btn-sm btn-secondary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <a href="/ChequeBookRequest/Delete/@request.ChequeBookRequestId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }

                                        <a href="/ChequeBookRequest/Details/@request.ChequeBookRequestId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (User.IsInRole("Admin") && request.Status == "Pending")
                                        {
                                            <form action="/ChequeBookRequest/Approve/@request.ChequeBookRequestId"
                                                  method="post"
                                                  class="d-inline m-0">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>

                                            </form>

                                            <form action="/ChequeBookRequest/Reject/@request.ChequeBookRequestId"
                                                  method="post"
                                                  class="d-inline m-0">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-lg"></i> Reject
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div class="stat-icon-badge mx-auto mb-3" style="width: 56px; height: 56px; font-size: 24px;">
                    <i class="bi bi-journal-text"></i>
                </div>

                <h5 class="fw-bold text-dark mb-1">No cheque book requests</h5>

                <p class="text-muted mb-3" style="font-size: 13px;">
                    You have not submitted any cheque book requests yet.
                </p>

                <a href="/ChequeBookRequest/Create"
                   class="btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Request Cheque Book
                </a>

            </div>
        }

    </div>

</div>