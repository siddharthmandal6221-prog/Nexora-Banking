@model IEnumerable<OnlineBankingApplication.DTOs.BankAccountDto>
@{
    ViewData["Title"] = User.IsInRole("Admin")
        ? "Bank Accounts"
        : "My Bank Accounts";

    var isAdmin = User.IsInRole("Admin");

    var accounts = Model?.ToList() ?? new List<OnlineBankingApplication.DTOs.BankAccountDto>();
    var totalBalance = accounts.Sum(a => a.Balance);
    var activeAccounts = accounts.Count(a => a.IsActive);
}

<div class="bank-page">

    <!-- HEADER -->
    <div class="bank-header">

        <div>
            <h1>
                @(isAdmin ? "Bank Accounts" : "My Bank Accounts")
            </h1>

            <p>
                @(isAdmin
                    ? "Manage customer bank accounts and liquid balances."
                    : "View your active accounts, balances, and transaction limits.")
            </p>
        </div>

        @if (isAdmin)
        {
            <a asp-action="Create"
               class="btn add-account-btn">
                <i class="bi bi-plus-lg me-1"></i> Add Bank Account
            </a>
        }

    </div>


    <!-- SUMMARY TILES -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="summary-label">
                        Total Accounts
                    </div>

                    <div class="summary-value">
                        @accounts.Count
                    </div>
                </div>

                <div class="stat-icon-badge" style="width: 46px; height: 46px; font-size: 20px;">
                    <i class="bi bi-bank2"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="summary-label">
                        Active Accounts
                    </div>

                    <div class="summary-value text-success">
                        @activeAccounts
                    </div>
                </div>

                <div class="stat-icon-badge" style="width: 46px; height: 46px; font-size: 20px; background: #dcfce7; color: #15803d;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-box p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="summary-label">
                        Total Combined Balance
                    </div>

                    <div class="summary-value text-primary">
                        ₹@totalBalance.ToString("N2")
                    </div>
                </div>

                <div class="stat-icon-badge" style="width: 46px; height: 46px; font-size: 20px; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-currency-rupee"></i>
                </div>
            </div>
        </div>

    </div>


    <!-- ACCOUNTS LIST PANEL -->
    <div class="section-card">

        <div class="p-4 border-bottom">

            <h2 class="fw-bold fs-5 m-0" style="color: var(--nexora-text-heading);">
                @(isAdmin ? "All Registered Bank Accounts" : "My Accounts")
            </h2>

            <p class="text-muted m-0" style="font-size: 13px;">
                @(isAdmin
                    ? "View and manage all customer bank accounts."
                    : "Your active bank accounts and current balances.")
            </p>

        </div>


        @if (accounts.Any())
        {

            <div class="p-4">

                <div class="row g-3">

                    @foreach (var account in accounts)
                    {

                        <div class="col-lg-6">

                            <div class="account-card p-4 h-100">

                                <div class="d-flex justify-content-between align-items-start mb-3">

                                    <div class="stat-icon-badge" style="width: 48px; height: 48px; font-size: 22px;">
                                        <i class="bi bi-bank2"></i>
                                    </div>

                                    <span class="badge bg-primary text-white fw-bold px-3 py-2" style="border-radius: 20px; font-size: 12px;">
                                        @account.AccountType
                                    </span>

                                </div>


                                <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                                    Account Number
                                </div>

                                <div class="fw-bold fs-5 text-dark tracking-wider mb-3">
                                    @account.AccountNumber
                                </div>


                                <div class="d-flex justify-content-between align-items-end pt-3 border-top mb-3">

                                    <div>

                                        <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 10px;">
                                            Available Balance
                                        </div>

                                        <div class="fw-bold fs-4 text-success">
                                            ₹@account.Balance.ToString("N2")
                                        </div>

                                    </div>


                                    @if (account.IsActive)
                                    {
                                        <span class="badge-status badge-active">
                                            <i class="bi bi-check-circle-fill"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-rejected">
                                            <i class="bi bi-x-circle-fill"></i> Inactive
                                        </span>
                                    }

                                </div>


                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">

                                    <span class="text-muted" style="font-size: 12px;">
                                        <i class="bi bi-calendar3 me-1"></i> Opened @(account.CreatedDate != default && account.CreatedDate.Year >= 2000 ? account.CreatedDate.ToString("dd MMM yyyy") : DateTime.Now.ToString("dd MMM yyyy"))
                                    </span>


                                    <div class="d-flex gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@account.BankAccountId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@account.BankAccountId"
                                               class="btn btn-sm btn-secondary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@account.BankAccountId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            </div>

        }
        else
        {

            <div class="text-center py-5 px-3">

                <div class="stat-icon-badge mx-auto mb-3" style="width: 64px; height: 64px; font-size: 28px;">
                    <i class="bi bi-bank2"></i>
                </div>

                <h3 class="fw-bold fs-5 text-dark mb-2">
                    No Bank Accounts Registered
                </h3>

                <p class="text-muted mb-4" style="font-size: 14px;">
                    @(isAdmin
                        ? "There are currently no bank accounts registered in the system."
                        : "You currently do not have any active bank accounts.")
                </p>

                @if (isAdmin)
                {
                    <div>
                        <a asp-action="Create"
                           class="btn add-account-btn">
                            <i class="bi bi-plus-lg me-1"></i> Create Bank Account
                        </a>
                    </div>
                }

            </div>

        }

    </div>

</div>