@model OnlineBankingApplication.DTOs.BankAccountDto
@{
    ViewData["Title"] = "Delete Bank Account";
}

<h1>Delete Bank Account</h1>

<h3>Are you sure you want to delete this bank account?</h3>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Account ID
            </dt>
            <dd class="col-sm-9">
                @Model.BankAccountId
            </dd>

            <dt class="col-sm-3">
                Account Number
            </dt>
            <dd class="col-sm-9">
                @Model.AccountNumber
            </dd>

            <dt class="col-sm-3">
                Account Type
            </dt>
            <dd class="col-sm-9">
                @Model.AccountType
            </dd>

            <dt class="col-sm-3">
                Balance
            </dt>
            <dd class="col-sm-9">
                @Model.Balance
            </dd>

            <dt class="col-sm-3">
                Customer ID
            </dt>
            <dd class="col-sm-9">
                @Model.CustomerId
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @(Model.IsActive ? "Active" : "Inactive")
            </dd>

        </dl>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="BankAccountId" />

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>